# cmd.exe misreads labels and calls in batch files with LF line ends.
*.cmd text eol=crlf
*.bat text eol=crlf
# Compared byte for byte (the xz streams hold text.txt as it is).
testdata/xz/* -text
# Compared byte for byte with what the tools wrote (LF), and binary.
testdata/bitcode/* -text
# Run by Linux shells (WSL), which misread CR line ends.
*.sh text eol=lf
# Hashed into lib /DEF's export files (their SHA-256), so the fixtures hold
# them as they were when built: tools/coff/imports' as committed (LF), the
# archives' (copied in by tools/coff/imports.cmd) as Windows checked them out.
tools/coff/imports/*.def -text
tools/coff/archives/def/*.def text eol=crlf
# Embedded and hashed into testdata/clr/Sample.dll as committed (CRLF).
tools/clr/*.txt -text
# dexdump's output (CRLF, as dexdump.exe writes it, with MUTF-8 bytes that
# needn't be UTF-8) and the DEX files it dumps, byte for byte.
testdata/dex/* -text
