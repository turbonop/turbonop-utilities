+impl Builder {
+    /// The base map's ranges for a `/GL` object at `offset`: its header,
+    /// the IL object's headers and symbol table, and each IL section by
+    /// name. (IL has no memory size: what code it becomes is the back
+    /// end's to say.)
+    fn ltcg(&mut self, offset: u64, l: &LtcgObject<'_>) {
+        self.file(offset, turbonop_pe::ltcg::HEADER_SIZE as u64, LTCG_HEADER);
+        let header = turbonop_pe::ltcg::HEADER_SIZE as u64;
+        self.file(offset + header, 20, COFF_HEADER);
+        self.file(
+            offset + header + 20,
+            (l.headers_end as u64).saturating_sub(header + 20),
+            COFF_SECTION_HEADERS,
+        );
+        for st in l.streams() {
+            let name = String::from_utf8_lossy(st.name).into_owned();
+            self.file(offset + st.offset, st.data.len() as u64, &name);
+        }
+        let (at, len) = l.symbol_table;
+        if len > 0 {
+            self.file(offset + at, len, COFF_SYMBOLS);
+        }
+    }
+}
+
+/// The symbols source of a `/GL` object at `offset`: each function's IL
+/// (its `.cil$ex` unit and its `.cil$sy` stream), each variable's
+/// initializer (`.cil$in`), and each symbol's record (`.cil$gl`), charged
+/// to the symbol; the IL of functions with no record to
+/// [`LTCG_UNREFERENCED`].
+fn ltcg_symbols(
+    l: &LtcgObject<'_>,
+    offset: u64,
+    labels: &mut Labels,
+    map: &mut DualMap,
+    base: &DualMap,
+) {
+    let Ok(g) = l.globals() else { return };
+    let mut demangler = turbonop_demangle::msvc::Demangler::default();
+    let label_of: Vec<Label> = g
+        .symbols
+        .iter()
+        .map(|s| labels.intern(&display(&mut demangler, s.name)))
+        .collect();
+    let mut add = |section: &[u8], start: u64, end: u64, label: Label| {
+        if let Some(at) = l.stream_offset(section)
+            && start < end
+        {
+            map.add_file(offset + at + start, offset + at + end, label, base);
+        }
+    };
+    for (s, &label) in g.symbols.iter().zip(&label_of) {
+        add(b".cil$gl", s.offset as u64, s.end as u64, label);
+    }
+    let units = l.il_units();
+    let locals = l.locals().ok();
+    let agrees = locals.as_ref().is_some_and(|x| units.agrees_with(x));
+    let unreferenced = labels.intern(LTCG_UNREFERENCED);
+    if agrees && let Some(locals) = &locals {
+        let mut owner = vec![unreferenced; units.len()];
+        for (s, &label) in g.symbols.iter().zip(&label_of) {
+            if let Some(il) = s.il
+                && let Some(k) = units.index_of(il.il_offset)
+            {
+                owner[k] = label;
+            }
+        }
+        for (k, &label) in owner.iter().enumerate() {
+            if let Some((a, e)) = units.range(k) {
+                add(b".cil$ex", a.into(), e.into(), label);
+            }
+            if let Some(f) = locals.functions.get(k) {
+                add(b".cil$sy", f.offset as u64, f.end as u64, label);
+            }
+        }
+    } else {
+        // (Units not found: each function's IL from its offset to the
+        // next one's.)
+        let len = l.stream(b".cil$ex").map_or(0, <[u8]>::len);
+        for ((s, size), &label) in g.symbols.iter().zip(g.il_sizes(len)).zip(&label_of) {
+            if let (Some(il), Some(size)) = (s.il, size) {
+                let a = u64::from(il.il_offset);
+                add(b".cil$ex", a, a + u64::from(size), label);
+            }
+        }
+    }
+    if let Ok(init) = l.initializers() {
+        let mut by_id: Vec<(u32, Label)> =
+            g.symbols.iter().map(|s| s.id).zip(label_of.iter().copied()).collect();
+        by_id.sort_unstable_by_key(|e| e.0);
+        for i in &init.list {
+            if let Ok(k) = by_id.binary_search_by_key(&i.id, |e| e.0) {
+                add(b".cil$in", i.offset as u64, i.end as u64, by_id[k].1);
+            }
+        }
+    }
+}
